# Copy to .env and fill in. .env is gitignored. Never commit real values.
# NASA FIRMS MAP_KEY — https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# NASA Earthdata user token — https://urs.earthdata.nasa.gov/profile -> Generate Token (LAADS VNP14IMG pulls)
EARTHDATA_TOKEN=
# Copernicus CDS API key — https://cds.climate.copernicus.eu/profile (ERA5 cloud cover)
CDS_API_KEY=
# Contact address used in the User-Agent of polite scrapers (DeepState backfill)
CONTACT_EMAIL=jmackney@uchicago.edu
# OSF personal access token — https://osf.io/settings/tokens
OSF_TOKEN=
